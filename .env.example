# 최초 학습은 아래 두 값이 없어도 가능하다.
# calculate_baseline.py가 출력한 두 줄을 그대로 복사한다.
BASELINE_RMSLE=
BASELINE_MODEL_VERSION=
# 선택 설정. 최초 모델은 미설정 시 validation으로 선택한다.
# 재학습은 미설정 시 현재 모델 B의 max(B*1.3, B+0.1)을 상한으로 사용한다.
DEPLOY_RMSLE_GATE=
AUTO_RETRAIN=true
# 변화 후 별도 데이터가 준비되면 설정한다. 프로젝트 루트 기준 상대 경로도 가능하다.
RETRAIN_TRAIN_CSV=
RETRAIN_VALIDATION_CSV=
MODEL_SOURCE=local
LOADING_MODE=lazy
