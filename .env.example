# 최초 학습은 아래 두 값이 없어도 가능하다.
# calculate_baseline.py가 출력한 두 줄을 그대로 복사한다.
BASELINE_RMSLE=
BASELINE_MODEL_VERSION=
# 선택 설정. 최초 모델은 미설정 시 validation으로 선택한다.
# 재학습은 이 값과 무관하게 동일 검증에서 기존 모델보다 RMSLE가 낮으면 교체한다.
DEPLOY_RMSLE_GATE=
AUTO_RETRAIN=true
# 일반 재학습 API용. run_scenarios.py는 test_drift를 나누므로 아래 경로가 필요 없다.
RETRAIN_TRAIN_CSV=
RETRAIN_VALIDATION_CSV=
# 최초 학습·기준값 계산은 false. 시연 서버를 켤 때 true로 설정한다.
# true이면 시작할 때마다 runtime/demo만 초기화하고 원본 runtime은 보존한다.
DEMO_MODE=false
MODEL_SOURCE=local
LOADING_MODE=lazy
